# Finora runtime configuration. Copy to .env and adjust as needed.
# The application runs locally on 127.0.0.1 by default.

FINORA_HOST=127.0.0.1
FINORA_PORT=8000
FINORA_DEBUG=false
FINORA_RELOAD=false
FINORA_WORKERS=1

# Data and database (SQLite by default)
FINORA_BASE_DIR=
FINORA_DATA_DIR=
FINORA_DATABASE_FILE=finora.db
FINORA_DATABASE_URL=

# Display
FINORA_BASE_CURRENCY=USD
FINORA_CURRENCY_SYMBOL=$
FINORA_DEFAULT_LANGUAGE=ru
FINORA_SUPPORTED_LANGUAGES=ru,en
FINORA_PAGE_SIZE=25

# Uploads
FINORA_CSV_MAX_UPLOAD_MB=10

# Security (generated automatically if empty)
FINORA_SECRET_KEY=